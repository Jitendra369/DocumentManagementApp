# Template for local development. Copy to .env (git-ignored) and fill in your values.
# Real environment variables override values in .env.

# ---------- PostgreSQL (required) ----------
DB_NAME=postgres
DB_URL=jdbc:postgresql://localhost:5432/postgres
DB_USERNAME=postgres
DB_PASSWORD=change-me

# ---------- AWS / S3 ----------
# Required
S3_BUCKET=dms-documents-dev
AWS_REGION=ap-south-1

# Optional (local LocalStack values shown; for real AWS remove S3_ENDPOINT and set S3_PATH_STYLE=false)
S3_ENDPOINT=http://localhost:4566
S3_PATH_STYLE=true
S3_PRESIGN_MINUTES=10
S3_CREATE_BUCKET_IF_MISSING=true

# Optional. Leave unset on servers that use an IAM role.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
